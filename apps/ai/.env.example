# =============================================================================
# POSTULAE CV GENERATOR - Environment Variables
# =============================================================================
#
# Copy this file to .env and fill in your API keys
#   cp .env.example .env
#
# NEVER commit .env to git (already in .gitignore)
#

# -----------------------------------------------------------------------------
# OpenAI API (PDF Extraction)
# -----------------------------------------------------------------------------
# Used for: GPT-4o Vision PDF text extraction
# Get your key at: https://platform.openai.com/api-keys
# Cost: ~$0.0025 per CV
OPENAI_API_KEY=sk-proj-...


# -----------------------------------------------------------------------------
# Anthropic API (CV Structuration + Translation)
# -----------------------------------------------------------------------------
# Used for:
#   - Claude Sonnet 4.5: CV structuration (FR/EN)
#   - Claude Haiku 3: Translation (FR <-> EN)
# Get your key at: https://console.anthropic.com/settings/keys
# Cost: ~$0.058 per CV (Sonnet) + ~$0.005 per translation (Haiku)
ANTHROPIC_API_KEY=sk-ant-...


# -----------------------------------------------------------------------------
# Optional: Logging Configuration
# -----------------------------------------------------------------------------
# Set log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO
